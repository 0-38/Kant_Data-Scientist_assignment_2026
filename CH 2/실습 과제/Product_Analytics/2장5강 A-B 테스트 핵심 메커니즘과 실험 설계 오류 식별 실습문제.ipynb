    "# A / B 매장별 4주 평균 주간 매출 비교\n",
    "\n",
    "group_mean = (\n",
    "    location_sales\n",
    "    .groupby(\"Promotion\")[\"four_week_mean_sales\"]\n",
    "    .mean()\n",
    ")\n",
