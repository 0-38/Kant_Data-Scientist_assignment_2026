   "source": [
    "# 힌트: groupby(\"Promotion\") 이후 size()는 행 수, [\"LocationID\"].nunique()는 매장 수입니다.\n",
    "# A/B 집단별 행 수와 매장 수를 표로 출력하세요.\n",
    "# sorted(campaign_ab[\"week\"].unique())로 관측 주차를 확인하세요.\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. A/B 집단별 행 수, 고유 매장 수, 관측 주차\n",
    "# ============================================================\n",
    "\n",
    "group_summary = (\n",
    "    campaign_ab\n",
    "    .groupby(\"Promotion\")\n",
    "    .agg(\n",
    "        row_count=(\"LocationID\", \"size\"),\n",
    "        store_count=(\"LocationID\", \"nunique\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# A/B 역할 표시\n",
    "group_summary[\"group\"] = group_summary[\"Promotion\"].map({\n",
    "    1: \"A (대조군)\",\n",
    "    2: \"B (실험군)\"\n",
    "})\n",
    "\n",
    "group_summary = group_summary[[\"group\", \"Promotion\", \"row_count\", \"store_count\"]]\n",
    "\n",
    "print(\"[A/B 집단별 행 수와 고유 매장 수]\")\n",
    "display(group_summary)\n",
    "\n",
    "\n",
    "# 관측 주차\n",
    "observed_weeks = sorted(campaign_ab[\"week\"].unique())\n",
    "\n",
    "print(\"관측 주차 :\", observed_weeks)\n",
    "\n",
    "\n",
    "# 전체 고유 매장 수\n",
    "print(\n",
    "    \"전체 고유 매장 수 :\",\n",
    "    campaign_ab[\"LocationID\"].nunique()\n",
    ")"
   ]
